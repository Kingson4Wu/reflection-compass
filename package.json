{
  "name": "reflection-compass",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/prepare-sw.mjs",
    "test": "vitest run",
    "preview": "wrangler dev --config wrangler.local.jsonc",
    "db:local": "wrangler d1 execute compass --local --file worker/schema.sql",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "setup": "node scripts/setup-local.mjs",
    "test:browser": "playwright test",
    "test:integration": "node scripts/integration.mjs",
    "format": "prettier --write src worker tests scripts *.ts *.json *.jsonc public/*.js public/*.webmanifest index.html .github/workflows",
    "format:check": "prettier --check src worker tests scripts *.ts *.json *.jsonc public/*.js public/*.webmanifest index.html .github/workflows",
    "dev:api": "wrangler dev --config wrangler.jsonc",
    "deploy:backend": "node scripts/worker-config.mjs && wrangler deploy --config wrangler.deploy.json",
    "deploy:dry-run": "wrangler deploy --config wrangler.jsonc --dry-run --outdir .wrangler/dry-run",
    "preview:frontend": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test:split": "node scripts/test-split.mjs",
    "test:experience": "node scripts/test-split.mjs tests/browser/experience-eval.spec.ts"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "latest",
    "idb-keyval": "^6.2.0",
    "jose": "^6.2.15",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@playwright/test": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "latest",
    "esbuild": "^0.28.2",
    "jsonc-parser": "^3.3.1",
    "miniflare": "^4.20260730.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  },
  "overrides": {
    "miniflare": {
      "undici": "^7.30.1",
      "sharp": "^0.35.5"
    }
  },
  "description": "A lightweight bilingual reflection and action PWA with offline records and private sync.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kingson4Wu/reflection-compass.git"
  },
  "homepage": "https://kingson4wu.github.io/reflection-compass/",
  "bugs": {
    "url": "https://github.com/Kingson4Wu/reflection-compass/issues"
  }
}
